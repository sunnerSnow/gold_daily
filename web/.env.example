# Gold Daily 環境變數範例
# 複製成 .env.local（本機）或在 Vercel 專案設定中填入。這個檔案只能放範例或空值，不可放真實憑證。
# 所有變數都只在伺服器端使用；除了 NEXT_PUBLIC_APP_URL，不會送到瀏覽器。

# 選填：網站對外網址，用來組每日推播附的走勢圖網址（例如 https://gold.example.com）。
# 部署在 Vercel 時沒填會自動用正式網域；本機的 http://localhost 不會附圖（LINE 只接受 https）。
NEXT_PUBLIC_APP_URL=

# ---- Supabase（不填則使用記憶體，重啟就清空，只適合本機開發）----
SUPABASE_URL=
# 本系統所有資料存取都在伺服器端用 service role；anon key 目前沒有使用，保留給日後需要
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- LINE Messaging API（兩個都要填，否則畫面顯示「LINE 尚未連線」，不會送出任何訊息）----
LINE_CHANNEL_ACCESS_TOKEN=
# 格式：U 開頭加 32 個十六進位字元，在 LINE Developers Console > 頻道 > Basic settings > Your user ID
LINE_USER_ID=

# ---- 行情來源 ----
# goldapi：GoldAPI.io（正式來源，免費方案每月 100 次）；mock：Mock Provider（模擬資料，只供開發測試）
GOLD_PRICE_PROVIDER=mock
# GoldAPI 的金鑰（https://www.goldapi.io/dashboard），只放伺服器端
GOLD_PRICE_API_KEY=
# 商品代號、幣別、單位。GoldAPI 目前只支援 XAU + 幣別、單位 troy_oz（每金衡盎司）。
GOLD_SYMBOL=XAUUSD
GOLD_CURRENCY=USD
GOLD_UNIT=troy_oz
# 只供本機測試：讓 Mock Provider 模擬每月查價上限（例如 100），用來看查價次數保護的畫面
MOCK_MONTHLY_QUOTA=

# ---- 排程授權（至少 16 字元；Vercel Cron 會自動帶 Authorization: Bearer <CRON_SECRET>）----
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---- 管理介面登入（正式環境必填，否則管理介面會鎖住）----
ADMIN_PASSWORD=
# 至少 32 字元，用來簽登入 cookie
SESSION_SECRET=
